{
	"name": "salary-calculator",
	"version": "1.0.0",
	"description": "Obsidian plugin that breaks an hourly rate or annual salary down into a pay table.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.ts"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"typescript": "^5.6.0"
	}
}
